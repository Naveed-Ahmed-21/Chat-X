rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasParticipant(data) {
      return signedIn()
        && data != null
        && 'participants' in data
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function isChatParticipant(roomId) {
      let roomPath = /databases/$(database)/documents/chats/$(roomId);
      return signedIn()
        && (
          (exists(roomPath) && hasParticipant(get(roomPath).data))
          // New direct chats and their first message are written atomically.
          // getAfter() lets the message rule validate the parent room created
          // in the same batch.
          || (existsAfter(roomPath) && hasParticipant(getAfter(roomPath).data))
        );
    }

    function isGroup(data) {
      return data.get('isGroup', false) == true;
    }

    function isExistingGroupAdmin() {
      return hasParticipant(resource.data)
        && isGroup(resource.data)
        && request.auth.uid in resource.data.get('admins', []);
    }

    function isGroupAdminById(roomId) {
      let roomPath = /databases/$(database)/documents/chats/$(roomId);
      return signedIn()
        && exists(roomPath)
        && hasParticipant(get(roomPath).data)
        && isGroup(get(roomPath).data)
        && request.auth.uid in get(roomPath).data.get('admins', []);
    }

    function membershipUnchanged() {
      return request.resource.data.get('participants', [])
          == resource.data.get('participants', [])
        && request.resource.data.get('admins', [])
          == resource.data.get('admins', []);
    }

    function isSelfLeavingGroup() {
      return isGroup(resource.data)
        && hasParticipant(resource.data)
        && !(request.auth.uid
            in request.resource.data.get('participants', []))
        && request.resource.data.get('participants', []).size()
            == resource.data.get('participants', []).size() - 1
        && resource.data.get('participants', [])
            .hasAll(request.resource.data.get('participants', []))
        && request.resource.data.get('admins', [])
            == resource.data.get('admins', []);
    }

    function canUpdateMessage(roomId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();

      return isChatParticipant(roomId)
        && after.get('senderId', '') == before.get('senderId', '')
        && (
          (
            request.auth.uid == before.get('senderId', '')
            && changed.hasOnly([
              'message', 'isEdited', 'mediaUrl', 'duration', 'thumbnail',
              'fileName', 'fileSize', 'extension', 'status', 'isDeleted'
            ])
          )
          || (
            changed.hasOnly(['status', 'seenBy', 'reactions', 'deletedFor'])
            && (
              !changed.hasAny(['reactions'])
              || after.get('reactions', {}).diff(before.get('reactions', {}))
                  .affectedKeys().hasOnly([request.auth.uid])
            )
            && (
              !changed.hasAny(['deletedFor'])
              || after.get('deletedFor', {}).diff(before.get('deletedFor', {}))
                  .affectedKeys().hasOnly([request.auth.uid])
            )
          )
        );
    }

    match /users/{uid} {
      // ChatX currently uses a signed-in user directory to resolve chat peers.
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /chats/{roomId} {
      // Keep the participant predicate explicit so Firestore can authorize
      // the client's `participants arrayContains auth.uid` room query.
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if hasParticipant(request.resource.data)
        && request.resource.data.get('participants', []) is list
        && request.resource.data.get('participants', []).size() >= 2
        && (
          !isGroup(request.resource.data)
          || request.auth.uid in request.resource.data.get('admins', [])
        );
      allow update: if hasParticipant(resource.data)
        && (
          (
            membershipUnchanged()
            && (
              !isGroup(resource.data)
              || isExistingGroupAdmin()
              || request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'lastMessage', 'lastMessageSenderId',
                    'lastMessageTimestamp', 'pinnedBy', 'nicknames',
                    'deletedFor', 'clearChatAt', 'typingStatus'
                  ])
            )
          )
          || isExistingGroupAdmin()
          || isSelfLeavingGroup()
        );
      allow delete: if isExistingGroupAdmin();

      match /messages/{messageId} {
        allow read: if isChatParticipant(roomId);
        allow create: if isChatParticipant(roomId)
          && request.resource.data.get('senderId', '') == request.auth.uid;
        allow update: if canUpdateMessage(roomId);
        allow delete: if isChatParticipant(roomId)
          && (
            request.auth.uid == resource.data.get('senderId', '')
            || isGroupAdminById(roomId)
          );
      }
    }
  }
}
